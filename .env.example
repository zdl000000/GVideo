APP_ENV=development
HTTP_ADDR=:8080
DATABASE_PATH=./data/gvideo.db
MEDIA_DIR=./media
SESSION_TTL=168h
MAX_UPLOAD_BYTES=536870912
COOKIE_SECURE=false
HTTPS_HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_FILE=C:/absolute/path/to/fullchain.pem
TLS_KEY_FILE=C:/absolute/path/to/privkey.pem
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_WORKER_ENABLED=true
MEDIA_WORKER_POLL_INTERVAL=2s
MEDIA_PROBE_TIMEOUT=30s
HLS_ENABLED=true
HLS_TRANSCODE_TIMEOUT=30m
HLS_SEGMENT_SECONDS=4
