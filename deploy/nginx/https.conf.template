map $uri $gvideo_auth_limit_key {
    default "";
    ~^/api/v1/auth/(login|register)$ $binary_remote_addr;
}

map "$request_method:$uri" $gvideo_upload_limit_key {
    default "";
    "POST:/api/v1/videos" $binary_remote_addr;
}

limit_req_zone $gvideo_auth_limit_key zone=gvideo_auth:10m rate=10r/m;
limit_req_zone $gvideo_upload_limit_key zone=gvideo_upload:10m rate=2r/m;

server_tokens off;

# Docker's embedded DNS keeps the gateway attached to a recreated frontend
# container without requiring the gateway itself to be restarted.
resolver 127.0.0.11 valid=10s ipv6=off;

upstream gvideo_frontend {
    zone gvideo_frontend 64k;
    server frontend:80 resolve;
}

server {
    listen 80;
    server_name ${GVIDEO_HOST};

    location = /gateway-healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 308 https://${GVIDEO_HOST}${HTTPS_REDIRECT_PORT_SUFFIX}$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${GVIDEO_HOST};
    client_max_body_size 524m;
    limit_req_status 429;
    limit_req zone=gvideo_auth burst=10 nodelay;
    limit_req zone=gvideo_upload burst=3 nodelay;

    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:GVIDEO_TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=86400" always;

    location = /gateway-healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /gateway-readyz {
        access_log off;
        proxy_pass http://gvideo_frontend/readyz;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 2s;
        proxy_read_timeout 2s;
        proxy_send_timeout 2s;
    }

    location / {
        proxy_pass http://gvideo_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Override (not append) so client-supplied X-Forwarded-For values are
        # never trusted downstream; downstream rate limiting keys on the first
        # entry, which is then the real peer address.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header True-Client-IP "";
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }
}
