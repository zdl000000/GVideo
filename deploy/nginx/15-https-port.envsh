#!/bin/sh
set -eu

case "${HTTPS_PORT:-443}" in
    ''|*[!0-9]*)
        echo >&2 "HTTPS_PORT must be an integer between 1 and 65535."
        exit 1
        ;;
esac

if [ "$HTTPS_PORT" -lt 1 ] || [ "$HTTPS_PORT" -gt 65535 ]; then
    echo >&2 "HTTPS_PORT must be an integer between 1 and 65535."
    exit 1
fi

if [ "$HTTPS_PORT" = "443" ]; then
    export HTTPS_REDIRECT_PORT_SUFFIX=""
else
    export HTTPS_REDIRECT_PORT_SUFFIX=":$HTTPS_PORT"
fi
